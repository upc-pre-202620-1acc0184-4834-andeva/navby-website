---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import CtaButton from './CtaButton.astro';
import plane from '@/assets/hero/avion.png';
import { getDictionary, type Locale } from '@/i18n';
import { WEBAPP_URL } from '@/config';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = getDictionary(locale);

// Foto del cielo (ver docs/image-prompts.md). Si aún no existe, se usa el cielo WebGL.
const skyFiles = import.meta.glob<{ default: ImageMetadata }>(
  '../assets/hero/cielo.{jpg,jpeg,png,webp}',
  { eager: true },
);
const skyPhoto = Object.values(skyFiles)[0]?.default;
---

<section id="top" data-hero class="relative h-[100svh] min-h-[38rem] p-2 sm:p-3">
  <div
    data-hero-card
    class="on-dark relative isolate h-full overflow-hidden rounded-[1.25rem] bg-sky-night text-text-white sm:rounded-[1.75rem]"
  >
    <!-- Cielo de nubes: foto si existe; si no, degradado de respaldo + lienzo WebGL (src/scripts/sky.ts) -->
    <div
      class="absolute inset-0 -z-20"
      style="background: linear-gradient(to bottom, #172e78 0%, #4078e0 38%, #c2dbff 58%, #f4f7ff 64%, #b9c6ea 100%);"
      aria-hidden="true"
    >
    </div>
    {
      skyPhoto ? (
        <div data-sky-photo class="absolute inset-0 -z-10 will-change-transform" aria-hidden="true">
          <Image
            src={skyPhoto}
            alt=""
            widths={[960, 1600, 2400, 2752]}
            sizes="100vw"
            loading="eager"
            fetchpriority="high"
            class="size-full object-cover object-[50%_50%]"
          />
        </div>
      ) : (
        <canvas data-sky class="absolute inset-0 -z-10 size-full" aria-hidden="true" />
      )
    }

    <!-- Velos de legibilidad: el texto blanco nunca queda directamente sobre nube blanca -->
    <div
      class="pointer-events-none absolute inset-x-0 top-0 z-0 h-[48%] bg-linear-to-b from-[#0b1640]/75 via-[#0b1640]/30 to-transparent"
      aria-hidden="true"
    >
    </div>
    <div
      class="pointer-events-none absolute inset-x-0 bottom-0 z-0 h-[40%] bg-linear-to-t from-[#0b1640]/80 via-[#0b1640]/35 to-transparent"
      aria-hidden="true"
    >
    </div>

    <h1
      data-hero-title
      class="absolute inset-x-0 top-[17%] z-10 px-5 text-center text-[clamp(2.9rem,8.4vw,6rem)] leading-[0.95] font-bold tracking-[-0.035em] sm:top-[15%]"
    >
      <span class="block overflow-hidden pb-[0.08em]">
        <span data-hero-line class="block">{t.hero.titleA}</span>
      </span>
      <span class="block overflow-hidden pb-[0.08em]">
        <span data-hero-line class="block font-light text-accent-soft italic">{t.hero.titleB}</span>
      </span>
    </h1>

    <!-- Avión frontal (src/assets/hero/avion.png, recorte transparente) -->
    <div
      class="pointer-events-none absolute inset-x-0 top-[58%] z-20 flex h-0 items-center justify-center lg:top-[60%]"
      aria-hidden="true"
    >
      <div data-plane-wrap class="w-[135vw] shrink-0 sm:w-[110vw] lg:w-[min(88vw,92rem)]">
        <div data-plane class="will-change-transform">
          <Image
            src={plane}
            alt=""
            widths={[800, 1400, 2000, 2705]}
            sizes="(min-width: 1024px) 88vw, 135vw"
            loading="eager"
            fetchpriority="high"
            class="h-auto w-full rotate-[4deg] drop-shadow-[0_30px_50px_rgb(11_22_64/0.35)] select-none"
            draggable="false"
          />
        </div>
      </div>
    </div>

    <div
      data-hero-foot
      class="absolute inset-x-0 bottom-0 z-30 flex flex-col items-start gap-6 p-5 sm:p-8 md:flex-row md:items-end md:justify-between lg:p-10"
    >
      <p
        data-hero-reveal
        class="hidden max-w-[26rem] text-[1.05rem] leading-relaxed text-white/85 sm:text-lg md:block"
      >
        {t.hero.lead}
      </p>
      <div data-hero-reveal class="flex flex-col items-start gap-3 md:items-end">
        <CtaButton href={WEBAPP_URL} size="lg">{t.hero.cta}</CtaButton>
        <p class="flex items-center gap-2 text-sm text-white/75">
          <span class="inline-block size-1.5 rounded-full bg-success" aria-hidden="true"></span>
          {t.hero.note}
        </p>
      </div>
    </div>
  </div>
</section>
<div data-hero-end aria-hidden="true"></div>
